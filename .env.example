# .env.example
# Rename this file to .env and fill in your details.

# Get your Discord bot token from the Discord Developer Portal
DISCORD_BOT_TOKEN="your token here"

# The URL of your LM Studio server.
# This is the default if you're running it on the same machine.
# If you changed the port or are running it on a different machine, update this.
LM_STUDIO_API_URL="http://localhost:1234/v1"

# If you're using Gemini, put the key here
GEMINI_API_KEY="your gemini key here"

# Optional: Override default Gemini models or timeout (default fallback: gemini-2.5-flash-lite, default timeout: 30)
# GEMINI_MODEL="gemini-2.0-flash"
# GEMINI_FALLBACK_MODEL="gemini-2.5-flash-lite"
# GEMINI_TIMEOUT="30.0"

# Optional: Jina Reader API Key (https://jina.ai/reader) for higher rate limits.
# Not required for standard web browsing.
# JINA_API_KEY="your jina api key here"

# Optional: Enable Server Members Intent (requires turning on 'Server Members Intent' in Discord Developer Portal)
# Useful for exact member counts on roles in large servers (100+ members).
# ENABLE_MEMBERS_INTENT="false"

# NOTE: Operational settings such as LLM provider, model name, fallback model, timeout, max history,
# background running, and prompts are managed in `settings.json` and via slash commands:
# - /provider (or /source) to switch between LM Studio and Gemini
# - /model to change the active LLM model
# - /fallbackmodel to change the Gemini fallback model
# - /timeout to adjust the Gemini request timeout
# - /setprompt, /random, /think, /grounding
